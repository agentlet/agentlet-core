exports[`Dialog command prompt dialog matches the expected markup for a default showCommandPrompt() call 1`] = `"<div class="agentlet-dialog-overlay agentlet-command-overlay" style="position: fixed; top: 0px; left: 0px; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); z-index: 100150; display: flex; align-items: center; justify-content: center;"><div class="agentlet-command-dialog" style="background: rgb(255, 255, 255); border-radius: 12px; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4); max-width: 800px; min-width: 400px; width: 80%; font-family: system-ui, -apple-system, sans-serif; display: flex; flex-direction: column; position: relative; z-index: 100200;"><div class="agentlet-command-header" style="padding: 24px 30px 20px; border-bottom: 2px solid rgb(224, 224, 224); display: flex; align-items: center; justify-content: center; gap: 15px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 12px 12px 0 0; flex-shrink: 0;"><span style="font-size: 32px;">⚡</span><h2 style="margin: 0px; color: rgb(51, 51, 51); font-size: 24px; font-weight: 700;">Command Prompt</h2></div><div class="agentlet-command-content" style="padding: 30px; display: flex; flex-direction: column; align-items: center; gap: 20px; flex: 1 1 0%;"><div class="agentlet-command-message" style="color: rgb(51, 51, 51); font-size: 18px; line-height: 1.5; text-align: center; margin-bottom: 10px;">Type a command</div><input type="text" class="agentlet-command-input" placeholder="go..." style="width: 100%; padding: 20px 24px; border: 3px solid rgb(224, 224, 224); border-radius: 12px; font-size: 24px; font-family: system-ui, -apple-system, sans-serif; font-weight: 500; box-sizing: border-box; text-align: center; background: rgb(255, 255, 255); color: rgb(51, 51, 51); transition: all 0.2s ease; outline: none; border-color: rgb(0, 123, 255); box-shadow: 0 0 0 4px rgba(0, 123, 255, 0.15); transform: scale(1.02);"><div class="agentlet-command-buttons" style="display: flex; gap: 15px; justify-content: center; margin-top: 10px;"><button style="padding: 12px 24px; border: 2px solid rgb(204, 204, 204); border-radius: 8px; background: rgb(248, 249, 250); color: rgb(51, 51, 51); cursor: pointer; font-size: 16px; font-weight: 600; transition: all 0.2s; min-width: 100px;">Cancel</button><button style="padding: 12px 24px; border: 2px solid rgb(0, 123, 255); border-radius: 8px; background: rgb(0, 123, 255); color: white; cursor: pointer; font-size: 16px; font-weight: 600; transition: all 0.2s; min-width: 100px;">Execute</button></div></div></div></div>"`;

