exports[`Dialog info dialog matches the expected markup for a default showInfo() call 1`] = `"<div class="agentlet-dialog-overlay agentlet-info-overlay" style="position: fixed; top: 0px; left: 0px; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); z-index: 100150; display: flex; align-items: center; justify-content: center;"><div class="agentlet-info-dialog" style="background: rgb(255, 255, 255); border-radius: 8px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3); max-width: 500px; min-width: 300px; width: auto; max-height: 80vh; overflow: hidden; display: flex; flex-direction: column; font-family: system-ui, -apple-system, sans-serif; position: relative; z-index: 100200; visibility: visible; opacity: 1;"><div class="agentlet-info-header" style="padding: 20px 20px 15px; border-bottom: 1px solid rgb(224, 224, 224); display: flex; align-items: center; justify-content: center; gap: 10px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); flex-shrink: 0;"><span style="font-size: 24px;">ℹ️</span><h3 style="margin: 0px; color: rgb(51, 51, 51); font-size: 18px; font-weight: 600;">Heads up</h3></div><div class="agentlet-info-content" style="padding: 20px; color: rgb(51, 51, 51); line-height: 1.5; flex: 1 1 0%; overflow-y: auto;">Something happened</div><div class="agentlet-info-buttons" style="padding: 0px 20px 20px; display: flex; gap: 10px; justify-content: flex-end; flex-shrink: 0;"><button style="padding: 10px 20px; border: 1px solid rgb(204, 204, 204); border-radius: 4px; cursor: pointer; font-size: 14px; transition: all 0.2s; background: rgb(0, 123, 255); color: white; border-color: rgb(0, 123, 255);">OK</button></div></div></div>"`;

