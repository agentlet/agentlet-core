exports[`Dialog progress dialog matches the expected markup for a default showProgress() call with steps 1`] = `"<div class="agentlet-dialog-overlay agentlet-progress-overlay" style="position: fixed; top: 0px; left: 0px; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); z-index: 100150; display: flex; align-items: center; justify-content: center;"><div class="agentlet-progress-dialog" style="background: rgb(255, 255, 255); border-radius: 8px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3); max-width: 500px; min-width: 400px; font-family: system-ui, -apple-system, sans-serif; position: relative; z-index: 100200;"><div class="agentlet-progress-header" style="padding: 20px 20px 15px; border-bottom: 1px solid rgb(224, 224, 224); display: flex; align-items: center; gap: 10px;"><span style="font-size: 24px;">📊</span><h3 style="margin: 0px; color: rgb(51, 51, 51); font-size: 18px; font-weight: 600; flex: 1 1 0%;">Processing</h3><button style="background: none; font-size: 24px; cursor: pointer; padding: 0px; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; color: rgb(51, 51, 51); opacity: 0.6; transition: opacity 0.2s;">×</button></div><div class="agentlet-progress-content" style="padding: 20px;"><p class="agentlet-progress-message" style="margin: 0px 0px 20px 0px; color: rgb(51, 51, 51); line-height: 1.5;">Working...</p><div class="agentlet-progress-container" style="margin-bottom: 15px;"><div class="agentlet-progress-bar" style="width: 100%; height: 20px; background: rgb(224, 224, 224); border-radius: 10px; overflow: hidden; position: relative;"><div class="agentlet-progress-fill" style="height: 100%; background: rgb(0, 123, 255); width: 0%; transition: width 0.3s ease; position: relative; background-image: linear-gradient(45deg, rgba(255, 255, 255, 0.2) 25%, transparent 25%, transparent 50%, rgba(255, 255, 255, 0.2) 50%, rgba(255, 255, 255, 0.2) 75%, transparent 75% ); background-size: 20px 20px; animation: agentlet-progress-animate 1s linear infinite;"></div></div></div><div class="agentlet-progress-info" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; font-size: 14px; color: rgb(102, 102, 102);"><span class="agentlet-progress-percentage">0%</span><span class="agentlet-progress-eta">Calculating...</span></div><div class="agentlet-progress-steps" style="margin-bottom: 15px;"><div style="font-weight: 600; margin-bottom: 10px; color: rgb(51, 51, 51);">Steps:</div><div class="agentlet-progress-step agentlet-progress-step-0" style="padding: 5px 0px; display: flex; align-items: center; gap: 10px; font-size: 14px; color: rgb(0, 123, 255);"><span class="agentlet-progress-step-icon">⏳</span><span>Step A</span></div><div class="agentlet-progress-step agentlet-progress-step-1" style="padding: 5px 0px; display: flex; align-items: center; gap: 10px; font-size: 14px; color: rgb(153, 153, 153);"><span class="agentlet-progress-step-icon">⚪</span><span>Step B</span></div></div></div></div></div>"`;

exports[`Dialog wait dialog matches the expected markup for a default showWait() call 1`] = `"<div class="agentlet-dialog-overlay agentlet-wait-overlay" style="position: fixed; top: 0px; left: 0px; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); z-index: 100150; display: flex; align-items: center; justify-content: center;"><div class="agentlet-wait-dialog" style="background: rgb(255, 255, 255); border-radius: 8px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3); max-width: 400px; min-width: 300px; font-family: system-ui, -apple-system, sans-serif; text-align: center; position: relative; z-index: 100200; display: block; visibility: visible; opacity: 1;"><div class="agentlet-wait-header" style="padding: 20px 20px 15px; border-bottom: 1px solid rgb(224, 224, 224); display: flex; align-items: center; justify-content: center; gap: 10px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);"><span style="font-size: 24px; animation: pulse 2s infinite;">🤖</span><h3 style="margin: 0px; color: rgb(51, 51, 51); font-size: 18px; font-weight: 600;">AI Processing</h3></div><div class="agentlet-wait-content" style="padding: 20px;"><div class="agentlet-wait-spinner" style="width: 40px; height: 40px; border: 4px solid rgb(224, 224, 224); border-top: 4px solid rgb(0, 123, 255); border-radius: 50%; animation: spin 1s linear infinite; margin: 0px auto 15px;"></div><p class="agentlet-wait-message" style="margin: 0px; color: rgb(51, 51, 51); line-height: 1.5;">Please wait...</p></div></div></div>"`;
