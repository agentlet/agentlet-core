                margin: 0;
                font-size: 14px;
                color: #495057;
            }
            
            .agentlet-module-version {
                font-size: 11px;
                color: #6c757d;
                background: #f8f9fa;
                padding: 2px 6px;
                border-radius: 10px;
            }
            
            .agentlet-btn {
                background: #007bff;
                color: white;
                border: none;
                padding: 6px 12px;
                border-radius: 4px;
                cursor: pointer;
                font-size: 12px;
                margin: 2px;
                transition: background-color 0.2s ease;
            }
            
            .agentlet-btn:hover {
                background: #0056b3;
            }
            
            .agentlet-btn-secondary {
                background: #6c757d;
            }
            
            .agentlet-btn-secondary:hover {
