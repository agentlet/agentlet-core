                --agentlet-image-overlay-right: 20px;
                --agentlet-image-overlay-z-index: 100400;
                --agentlet-image-overlay-transition: all 0.3s ease;
                --agentlet-image-overlay-hover-scale: 1.05;
            }
        "
`;

