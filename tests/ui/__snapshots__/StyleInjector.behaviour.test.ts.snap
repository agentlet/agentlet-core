                --agentlet-dialog-box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
                --agentlet-dialog-header-background: #ffffff;
                --agentlet-dialog-header-text-color: #333333;
                --agentlet-dialog-content-background: #ffffff;
                --agentlet-dialog-content-text-color: #333333;
                --agentlet-dialog-button-primary-background: #1E3A8A;
                --agentlet-dialog-button-primary-hover: #1E40AF;
                --agentlet-dialog-button-secondary-background: #6B7280;
                --agentlet-dialog-button-secondary-hover: #4B5563;
                --agentlet-dialog-button-danger-background: #DC2626;
                --agentlet-dialog-button-danger-hover: #B91C1C;
                --agentlet-dialog-progress-bar-background: linear-gradient(90deg, #1E3A8A, #F97316);
                --agentlet-dialog-progress-bar-track-background: #f0f0f0;
                
                /* Spinner Theme Variables */
                --agentlet-spinner-track-color: #f3f3f3;
