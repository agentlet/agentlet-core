                --agentlet-action-button-text: #333333;
                --agentlet-actions-justify-content: space-between;
                --agentlet-panel-width: 320px;
                --agentlet-border-radius: 0px;
                --agentlet-box-shadow: -2px 0 10px rgba(0,0,0,0.1);
                --agentlet-font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                --agentlet-header-padding: 15px;
                --agentlet-content-padding: 15px;
                --agentlet-actions-padding: 10px 15px;
