                border-radius: 4px;
                border-left: 3px solid #007bff;
            }
            
            .agentlet-submodule-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 6px;
            }
            
            .agentlet-submodule-header h4 {
                margin: 0;
                font-size: 12px;
