"
            /* CSS Custom Properties for Theme */
            :root {
                --agentlet-primary-color: #1E3A8A;
                --agentlet-secondary-color: #F97316;
                --agentlet-background-color: #ffffff;
                --agentlet-content-background: #f8f9fa;
